{
  "name": "maintainerr",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.11.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ydkmlt84/Maintainerr.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:changed": "node tools/format-changed.mjs",
    "format:check": "turbo format:check",
    "knip": "knip",
    "check-types": "turbo check-types",
    "test": "turbo test --",
    "test:watch": "turbo test:watch"
  },
  "workspaces": [
    "apps/ui",
    "apps/server",
    "packages/*"
  ],
  "resolutions": {
    "dompurify": "3.4.14",
    "nodemailer": "9.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.1",
    "knip": "^6.34.0",
    "semantic-release": "^25.0.9",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      "@semantic-release/npm",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "yarn --cwd apps/server version ${nextRelease.version} && yarn --cwd apps/ui version ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "apps/server/package.json",
            "apps/ui/package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "addReleases": "bottom",
          "successComment": false,
          "releasedLabels": false,
          "failComment": false,
          "failTitle": false
        }
      ]
    ],
    "branches": [
      "main"
    ],
    "npmPublish": false,
    "publish": [
      "@semantic-release/github"
    ]
  }
}
