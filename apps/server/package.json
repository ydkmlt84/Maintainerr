{
  "name": "@maintainerr/server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "nest:build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "yarn test:runtime:jellyfin-sdk && jest",
    "test:runtime:jellyfin-sdk": "node ./test/jellyfin-sdk-runtime-smoke.cjs",
    "test:clear": "jest --clearCache",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:create": "yarn exec typeorm-ts-node-commonjs migration:create",
    "migration:run": "yarn exec typeorm-ts-node-commonjs migration:run -d ./src/datasource-config.ts",
    "migration:revert": "yarn exec typeorm-ts-node-commonjs migration:revert -d ./src/datasource-config.ts",
    "migration:generate": "yarn exec typeorm-ts-node-commonjs migration:generate --dataSource ./src/datasource-config.ts -p",
    "migration:show": "yarn exec typeorm-ts-node-commonjs migration:show --dataSource ./src/datasource-config.ts"
  },
  "dependencies": {
    "@jellyfin/sdk": "^0.13.0",
    "@maintainerr/contracts": "workspace:^",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-throttling": "^11.0.5",
    "@tygra/nestjs-graceful-shutdown": "^2.0.0",
    "@types/express": "^5.0.6",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.11.1",
    "chalk": "^4.1.2",
    "cron": "^4.4.0",
    "cron-validator": "^1.4.0",
    "email-templates": "13.0.1",
    "http-terminator": "^3.2.0",
    "lodash": "^4.18.1",
    "mime-types": "^3.0.2",
    "nestjs-zod": "^5.5.0",
    "node-cache": "^5.1.2",
    "nodemailer": "9.1.1",
    "octokit": "^5.0.5",
    "openpgp": "^6.3.1",
    "read-last-lines": "^1.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@suites/di.nestjs": "^3.1.0",
    "@suites/doubles.jest": "^3.1.0",
    "@suites/unit": "^3.1.1",
    "@types/email-templates": "^10.0.4",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/mime-types": "^3",
    "@types/node": "^22",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(ts|js)$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@octokit|octokit|bottleneck|@jellyfin/sdk)/)"
    ],
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../test/jest.setup.ts"
    ]
  }
}
